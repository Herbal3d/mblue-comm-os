<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>org.herbal3d.mblue.comm</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exclude legacy code from compilation while converting the code. -->
    <Compile Remove="Legacy\**\*.cs" />
    <None Remove="Legacy\**" />
    <Content Remove="Legacy\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup Condition="Exists('../../mblue-ecm/src/mblue.ecm.Interface/mblue.ecm.Interface.csproj')">
    <ProjectReference Include="../../mblue-ecm/src/mblue.ecm.Interface/mblue.ecm.Interface.csproj" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('../../mblue-ecm/src/mblue.ecm.Interface/mblue.ecm.Interface.csproj')">
    <PackageReference Include="mblue.ecm.Interface" Version="*" />
  </ItemGroup>

  <ItemGroup Condition="Exists('../../mblue-comm/src/mblue.comm.Interface/mblue.comm.Interface.csproj')">
    <ProjectReference Include="../../mblue-comm/src/mblue.comm.Interface/mblue.comm.Interface.csproj" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('../../mblue-comm/src/mblue.comm.Interface/mblue.comm.Interface.csproj')">
    <PackageReference Include="mblue.comm.Interface" Version="*" />
  </ItemGroup>

  <ItemGroup Condition="Exists('../../libremetaverse/LibreMetaverse/LibreMetaverse.csproj')">
    <ProjectReference Include="../../libremetaverse/LibreMetaverse/LibreMetaverse.csproj" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('../../libremetaverse/LibreMetaverse/LibreMetaverse.csproj')">
    <PackageReference Include="LibreMetaverse" Version="*" />
  </ItemGroup>

  <ItemGroup Condition="Exists('../../libremetaverse/LibreMetaverse.StructuredData/LibreMetaverse.StructuredData.csproj')">
    <ProjectReference Include="../../libremetaverse/LibreMetaverse.StructuredData/LibreMetaverse.StructuredData.csproj" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('../../libremetaverse/LibreMetaverse.StructuredData/LibreMetaverse.StructuredData.csproj')">
    <PackageReference Include="LibreMetaverse.StructuredData" Version="*" />
  </ItemGroup>

  <ItemGroup Condition="Exists('../../mblue-common/src/mblue.common.csproj')">
    <ProjectReference Include="../../mblue-common/src/mblue.common.csproj" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('../../mblue-common/src/mblue.common.csproj')">
    <PackageReference Include="mblue.common" Version="*" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\*.json"
                Exclude="..\tsconfig.json;..\package.json;..\package-lock.json" >
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
